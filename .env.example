NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Optional Google login via Clerk. Leave empty to keep anonymous-only mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Production on vercel.app also needs a Frontend API proxy:
# NEXT_PUBLIC_CLERK_PROXY_URL=https://your-app.vercel.app/__clerk
# Keep OAuth on the app host instead of accounts.*.vercel.app:
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/create
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/create
# Keep convex/auth.config.ts issuers in sync with the Clerk Frontend API URL.


